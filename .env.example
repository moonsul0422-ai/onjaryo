# 자료 시트 (Google Sheets). 없으면 scripts/seed/*.csv 로 빌드한다.
SHEET_ID=
SHEET_RESOURCES_GID=0
SHEET_ORGS_GID=

# 배포 도메인. astro.config.mjs 의 site 기본값을 덮어쓴다.
SITE_URL=https://onjaryo.vercel.app

# 제보용 구글 폼 임베드 URL (.../viewform?embedded=true)
PUBLIC_SUBMIT_FORM_URL=

# 조회 카운터 저장소 (Upstash Redis / Vercel KV).
# 없으면 카운터가 조용히 꺼진다 — 사이트는 그대로 돌아간다.
# Vercel 마켓플레이스에서 Upstash 를 연동하면 자동으로 심어진다.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash 직접 연동 시의 이름도 받는다
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
