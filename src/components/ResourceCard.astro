---
// 목록 페이지 네 곳 + 홈 + 검색 결과에서 공유하는 카드.
// 검색 결과는 클라이언트에서 같은 클래스 이름으로 compact 형태를 다시 그린다.
// 마크업을 바꾸면 src/components/SearchResults.astro 의 렌더 함수도 같이 고쳐야 한다.
import { formatDateShort, resourceUrl, orgUrl, topicUrl } from '../lib/site.js';

interface Props {
  resource: any;
  org?: any;
  compact?: boolean;
  headingLevel?: 2 | 3;
}

const { resource, org = null, compact = false, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}`;
const orgLabel = org?.shortName ?? resource.orgCode;
---

<article class:list={['rcard', compact && 'rcard-compact']}>
  <Heading class="rcard-title">
    <a href={resourceUrl(resource.id)}>{resource.title}</a>
  </Heading>

  {!compact && resource.summary && <p class="rcard-sum">{resource.summary}</p>}

  <p class="rcard-meta">
    {org ? (
      <a class="rcard-org" href={orgUrl(org.code)}>{orgLabel}</a>
    ) : (
      <span class="rcard-org">{orgLabel}</span>
    )}
    {resource.publishedAt && (
      <>
        <span aria-hidden="true">·</span>
        <time datetime={resource.publishedAt}>{formatDateShort(resource.publishedAt)}</time>
      </>
    )}
    {resource.resourceType && (
      <>
        <span aria-hidden="true">·</span>
        <span>{resource.resourceType}</span>
      </>
    )}
  </p>

  {resource.topics.length > 0 && (
    <ul class="rcard-topics">
      {resource.topics.map((t: string) => (
        <li><a class="chip chip-sm" href={topicUrl(t)}>{t}</a></li>
      ))}
    </ul>
  )}
</article>

<style is:global>
  .rlist {
    list-style: none;
    display: grid;
    gap: 0.85rem;
    padding: 0;
    margin: 0;
  }

  .rcard {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem 1.1rem;
  }
  .rcard:hover { border-color: #c9cdbf; }

  .rcard-title {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.45;
    margin: 0 0 0.35rem;
  }
  .rcard-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .rcard-title a:hover { color: var(--go-dark); text-decoration: underline; }

  .rcard-sum {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rcard-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.32rem;
    margin: 0;
    font-size: 0.82rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .rcard-meta .rcard-org { color: var(--go-dark); font-weight: 600; text-decoration: none; }
  .rcard-meta a.rcard-org:hover { text-decoration: underline; }

  .rcard-topics {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    padding: 0;
    margin: 0.6rem 0 0;
  }
  .chip-sm { padding: 0.14rem 0.5rem; font-size: 0.78rem; }

  .rcard-compact { padding: 0.8rem 0.95rem; }
  .rcard-compact .rcard-title { font-size: 1.02rem; }
</style>
