---
// 자료 표지. coverImage 가 있으면 그 이미지를, 없으면 기관 색 카드를 그린다.
//
// 표지가 비어 있어도 목록이 멀쩡해 보여야 한다. 자료 대부분은 한동안 표지가
// 없을 것이고, 회색 네모가 줄줄이 늘어선 목록은 안 만드느니만 못하다.
interface Props {
  resource: any;
  org?: any;
  size?: 'sm' | 'md' | 'lg';
}

const { resource, org = null, size = 'md' } = Astro.props;

// 같은 기관은 늘 같은 색이 되게 코드에서 뽑는다. 무작위면 빌드마다 색이 바뀐다.
function hueOf(seed: string) {
  let h = 0;
  for (const ch of String(seed)) h = (h * 31 + ch.charCodeAt(0)) % 360;
  return h;
}

const hue = hueOf(resource.orgCode || resource.id);
const orgLabel = org?.shortName ?? resource.orgCode;

// 표지에 적을 짧은 이름. 「」 안에 붙은 자료명이 있으면 그것만 쓴다.
const bracket = /「(.+?)」/.exec(resource.title);
const short = (bracket ? bracket[1] : resource.title).slice(0, 22);
---

{resource.coverImage ? (
  <img
    class:list={['cover', `cover-${size}`]}
    src={resource.coverImage}
    alt=""
    loading="lazy"
    decoding="async"
  />
) : (
  <span class:list={['cover', 'cover-fb', `cover-${size}`]} style={`--cover-h:${hue}`} aria-hidden="true">
    <span class="cover-t">{short}</span>
    <span class="cover-o">{orgLabel}</span>
  </span>
)}
