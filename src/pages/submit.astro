---
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, SITE_NAME, SUBMIT_FORM_URL } from '../lib/site.js';

// 제보에서 받아야 하는 건 원문 주소 하나다. 기관·영역·설명을 받는 칸을 늘어놓으면
// 제보하는 사람이 숙제를 받은 기분이 되고, 그 칸들은 어차피 우리가 원문을 열어
// 다시 채운다. 주소만 받고 나머지는 등록할 때 채운다.
//
// 자체 폼과 서버는 만들지 않는다. 구글 폼이 연결돼 있으면 그대로 끼워 넣고,
// 없으면 메일 앱을 여는 붙여넣기 칸을 둔다. 어느 쪽이든 한 곳에 모인다.
// (운영자: PUBLIC_SUBMIT_FORM_URL 에 구글 폼 주소를 넣으면 양식이 이 자리에 들어간다.
//  폼은 "원문 주소" 한 칸짜리로 만든다.)
const formUrl = SUBMIT_FORM_URL;
const embedUrl = formUrl && !/[?&]embedded=true/.test(formUrl)
  ? `${formUrl}${formUrl.includes('?') ? '&' : '?'}embedded=true`
  : formUrl;

const mailto = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('[온자료 제보]')}`;

const description = `${SITE_NAME}에 빠진 교육자료의 원문 주소를 알려 주세요. 주소 하나면 됩니다.`;
---

<Base title="자료 제보" description={description} canonical="/submit/">
  <header class="page-head">
    <h1>자료 제보</h1>
    <p class="lede">
      자료 원문 주소만 알려 주세요. 기관·영역·요약은 저희가 원문을 열어 채웁니다.
      끊긴 링크나 잘못된 분류도 그 주소를 그대로 보내 주시면 됩니다.
    </p>
  </header>

  {embedUrl ? (
    <section class="formwrap" aria-labelledby="form-h">
      <h2 id="form-h" class="visually-hidden">제보 양식</h2>
      <iframe
        src={embedUrl}
        title="자료 제보 양식"
        loading="lazy"
        width="100%"
        height="720"
      >양식을 불러오는 중입니다…</iframe>
      <p class="hint">
        양식이 보이지 않으면 <a href={formUrl} rel="noopener">새 창에서 열기</a>를 눌러 주세요.
      </p>
    </section>
  ) : (
    <section class="note" aria-labelledby="form-h">
      <h2 id="form-h" class="visually-hidden">제보 양식</h2>
      <form class="paste" id="paste-form" data-mail={CONTACT_EMAIL}>
        <label class="paste-label" for="paste-urls">자료 원문 주소</label>
        <textarea
          id="paste-urls"
          name="urls"
          rows="4"
          spellcheck="false"
          placeholder="https://... 붙여 넣으세요. 여러 개면 줄을 바꿔서."
        ></textarea>
        <div class="paste-row">
          <button class="btn" type="submit">메일로 보내기</button>
          <p class="hint">
            메일 앱이 열립니다. 그대로 보내 주시면 됩니다.
            열리지 않으면 <a href={mailto}>{CONTACT_EMAIL}</a> 으로 주소를 보내 주세요.
          </p>
        </div>
      </form>
    </section>
  )}

  <p class="hint after">
    {SITE_NAME}는 파일을 보관하지 않고 기관 사이트로 가는 링크만 둡니다.
    원문 파일을 보내실 필요는 없습니다. 제보하신 분의 이름도 사이트에 표시하지 않습니다.
  </p>

  <section class="section">
    <h2>제보한 뒤에는</h2>
    <p class="lede">
      링크가 살아 있는지, 이미 등록된 자료는 아닌지 확인한 뒤 요약과 분류를 붙여 올립니다.
      보통 며칠 걸립니다. 원문이 비공개거나 이용 조건이 불분명해 등록이 어려운 경우에는
      따로 회신드리지 않을 수 있습니다.
    </p>
  </section>
</Base>

<script>
  // 서버가 없으니 메일 앱으로 넘긴다. 실패해도 주소는 화면에 그대로 적혀 있다.
  const form = document.getElementById('paste-form');
  const box = document.getElementById('paste-urls');

  if (form instanceof HTMLFormElement && box instanceof HTMLTextAreaElement) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const body = box.value.trim();
      if (!body) {
        box.focus();
        return;
      }
      const mail = form.dataset.mail ?? '';
      const q = `subject=${encodeURIComponent('[온자료 제보]')}&body=${encodeURIComponent(body)}`;
      window.location.href = `mailto:${mail}?${q}`;
    });
  }
</script>

<style>
  .paste-label {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--go-dark);
    margin-bottom: 0.45rem;
  }
  .paste textarea {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 0.95rem;
    line-height: 1.6;
    resize: vertical;
  }
  .paste-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.9rem;
    margin-top: 0.75rem;
  }
  .paste-row .hint { flex: 1 1 14rem; }

  .hint {
    margin: 0;
    font-size: 0.86rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .after { margin-top: 0.9rem; }

  .formwrap iframe {
    display: block;
    width: 100%;
    max-width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }
  .formwrap .hint { margin-top: 0.6rem; }
</style>
