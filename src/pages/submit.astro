---
import Base from '../layouts/Base.astro';
import { TOPICS } from '../lib/taxonomy.js';
import { CONTACT_EMAIL, SITE_NAME, SUBMIT_FORM_URL } from '../lib/site.js';

// 자체 폼을 만들지 않는다. 구글 폼을 그대로 끼워 넣는다.
// PUBLIC_SUBMIT_FORM_URL 이 비어 있으면 임베드 대신 안내로 대체한다.
const formUrl = SUBMIT_FORM_URL
  ? SUBMIT_FORM_URL.replace(/([?&])embedded=true/, '$1embedded=true')
  : '';
const embedUrl = formUrl && !/[?&]embedded=true/.test(formUrl)
  ? `${formUrl}${formUrl.includes('?') ? '&' : '?'}embedded=true`
  : formUrl;

const description = `${SITE_NAME}에 빠진 교육자료를 알려 주세요. 끊긴 링크나 잘못된 분류 신고도 받습니다.`;
---

<Base title="자료 제보" description={description} canonical="/submit/">
  <header class="page-head">
    <h1>자료 제보</h1>
    <p class="lede">
      빠진 자료, 끊긴 링크, 잘못된 분류를 알려 주세요. 하나하나 확인해서 반영합니다.
      제보하신 분의 이름은 사이트에 표시하지 않습니다.
    </p>
  </header>

  <section class="guide note">
    <h2 class="guide-h">이렇게 알려 주시면 빠릅니다</h2>
    <ul>
      <li><b>원문 주소</b> — 자료가 올라온 기관 페이지 주소. 가장 중요합니다.</li>
      <li><b>발행 기관</b> — 어느 교육청·기관 자료인지.</li>
      <li><b>어디에 쓰는 자료인지</b> — 한 줄이면 충분합니다. 요약은 저희가 씁니다.</li>
      <li><b>영역</b> — 아래 {TOPICS.length}개 중 해당하는 것. 모르시면 비워 두셔도 됩니다.</li>
    </ul>
    <p class="guide-topics">{TOPICS.join(' · ')}</p>
    <p class="guide-note">
      원문 파일을 직접 보내실 필요는 없습니다. {SITE_NAME}는 파일을 보관하지 않고
      기관 사이트로 가는 링크만 둡니다.
    </p>
  </section>

  {embedUrl ? (
    <section class="formwrap" aria-labelledby="form-h">
      <h2 id="form-h" class="visually-hidden">제보 양식</h2>
      <iframe
        src={embedUrl}
        title="자료 제보 양식"
        loading="lazy"
        width="100%"
        height="1100"
      >양식을 불러오는 중입니다…</iframe>
      <p class="formfall">
        양식이 보이지 않으면 <a href={formUrl} rel="noopener">새 창에서 열기</a>를 눌러 주세요.
      </p>
    </section>
  ) : (
    <section class="note" aria-labelledby="form-h">
      <h2 id="form-h" class="guide-h">제보 양식 준비 중</h2>
      <p>
        제보용 구글 폼이 아직 연결되지 않았습니다. 그동안은
        <a href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('[자료 제보]')}`}>{CONTACT_EMAIL}</a>
        으로 위 네 가지를 적어 보내 주세요.
      </p>
      <p class="guide-note">
        (운영자용) <code>PUBLIC_SUBMIT_FORM_URL</code> 환경변수에 구글 폼 주소를 넣으면
        이 자리에 양식이 그대로 들어갑니다.
      </p>
    </section>
  )}

  <section class="section">
    <h2>제보한 뒤에는</h2>
    <p class="lede">
      원문 링크가 살아 있는지, 이미 등록된 자료는 아닌지 확인한 뒤 요약과 분류를 붙여 올립니다.
      보통 며칠 걸립니다. 등록이 어려운 경우(원문이 비공개거나 이용 조건이 불분명한 경우)에는
      따로 회신드리지 않을 수 있습니다.
    </p>
  </section>
</Base>

<style>
  .guide { margin-bottom: 1.4rem; }
  .guide-h {
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
    color: var(--go-dark);
  }
  .guide ul { margin: 0 0 0.7rem; }
  .guide li { margin-bottom: 0.25rem; font-size: 0.94rem; }
  .guide b { font-weight: 600; }
  .guide-topics {
    font-size: 0.84rem;
    color: var(--muted);
    line-height: 1.9;
    margin-bottom: 0.7rem;
  }
  .guide-note { font-size: 0.86rem; color: var(--muted); margin: 0; }

  .formwrap iframe {
    display: block;
    width: 100%;
    max-width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }
  .formfall { margin: 0.6rem 0 0; font-size: 0.86rem; color: var(--muted); }
  code {
    background: var(--tint);
    padding: 0.05rem 0.3rem;
    border-radius: 4px;
    font-size: 0.9em;
  }
</style>
