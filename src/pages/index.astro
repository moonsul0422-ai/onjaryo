---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import ResourceCard from '../components/ResourceCard.astro';
import GradeNav from '../components/GradeNav.astro';
import TopicNav from '../components/TopicNav.astro';
import {
  byOrg, bySubject, meta, orgByCode, recent, usedOrgCodes, usedSubjects,
} from '../lib/data.js';
import { SITE_DESCRIPTION, SITE_NAME, formatDate, orgUrl, subjectUrl } from '../lib/site.js';

const latest = recent(10);
const topOrgs = usedOrgCodes.slice(0, 8);
---

<Base title={SITE_NAME} description={SITE_DESCRIPTION} canonical="/">
  <section class="hero">
    <h1>몇 학년, 무슨 과목인지만 고르세요</h1>
    <p class="hero-lede">
      전국 교육청이 공개한 수업자료를 학년과 과목으로 정리했습니다.
      찾은 자료는 <b>발행한 교육청 사이트에서 그대로</b> 내려받습니다.
    </p>
    <SearchBox id="q-home" size="lg" label="자료 검색" placeholder="예: 초3 분수, 안전교육 활동지" />
  </section>

  <section class="section pick" aria-labelledby="grade-h">
    <div class="section-head">
      <h2 id="grade-h">학년으로 찾기</h2>
    </div>
    <GradeNav big />
  </section>

  <section class="section pick" aria-labelledby="subject-h">
    <div class="section-head">
      <h2 id="subject-h">과목으로 찾기</h2>
    </div>
    <ul class="chips">
      {usedSubjects.map((s: string) => (
        <li>
          <a class="chip chip-big" href={subjectUrl(s)}>
            {s}<span class="n">{bySubject.get(s).length}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="recent-h">
    <div class="section-head">
      <h2 id="recent-h">최근 등록</h2>
      <a href="/search">전체 검색</a>
    </div>
    <ul class="rlist">
      {latest.map((r: any) => (
        <li><ResourceCard resource={r} org={orgByCode.get(r.orgCode) ?? null} headingLevel={3} /></li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="topics-h">
    <div class="section-head">
      <h2 id="topics-h">주제로 찾기</h2>
    </div>
    <p class="section-note">
      교과로 묶이지 않는 자료 — 안전교육, 학급운영, 학부모 안내 같은 것들은 여기 모입니다.
    </p>
    <TopicNav />
  </section>

  <section class="section" aria-labelledby="orgs-h">
    <div class="section-head">
      <h2 id="orgs-h">기관으로 찾기</h2>
    </div>
    <ul class="chips">
      {topOrgs.map((code: string) => (
        <li>
          <a class="chip" href={orgUrl(code)}>
            {orgByCode.get(code).shortName}<span class="n">{byOrg.get(code).length}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section stats" aria-labelledby="stats-h">
    <h2 id="stats-h" class="visually-hidden">등록 현황</h2>
    <dl class="statlist">
      <div>
        <dt>등록 자료</dt>
        <dd>{meta.total.toLocaleString('ko-KR')}건</dd>
      </div>
      <div>
        <dt>기관</dt>
        <dd>{meta.orgCount}곳</dd>
      </div>
      <div>
        <dt>마지막 갱신</dt>
        <dd><time datetime={meta.syncedAt}>{formatDate(meta.syncedAt.slice(0, 10))}</time></dd>
      </div>
    </dl>
    <p class="stats-note">
      자료 목록은 매일 한 번 갱신됩니다. 빠진 자료가 있다면 <a href="/submit">제보</a>해 주세요.
    </p>
  </section>
</Base>

<style>
  .hero {
    padding: 1.5rem 0 0.5rem;
    max-width: 42rem;
  }
  .hero h1 {
    font-family: var(--serif);
    font-weight: 700;
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.3rem);
    margin-bottom: 0.5rem;
  }
  .hero-lede {
    color: var(--muted);
    font-size: 1.02rem;
    margin-bottom: 1.1rem;
  }
  .hero-lede b { color: var(--ink); font-weight: 600; }

  .pick {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1rem 1.1rem 1.1rem;
  }
  .pick .section-head { margin-bottom: 0.8rem; }
  .section-note {
    font-size: 0.86rem;
    color: var(--muted);
    margin: -0.3rem 0 0.7rem;
  }

  .statlist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
    margin: 0 0 0.7rem;
    padding: 0.9rem 1.1rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .statlist > div { display: flex; flex-direction: column; }
  .statlist dt { font-size: 0.78rem; color: var(--muted); }
  .statlist dd {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .stats-note { margin: 0; font-size: 0.85rem; color: var(--muted); }
</style>
